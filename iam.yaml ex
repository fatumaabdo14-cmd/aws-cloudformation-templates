AWSTemplateFormatVersion: '2010-09-09'
Description: Create IAM user, group, policy, role, and add user to group.

Resources:
  MyIAMUser:
    Type: 'AWS::IAM::User'
    Properties:
      UserName: 'fatyCN'

  MyIAMGroup:
    Type: 'AWS::IAM::Group'
    Properties:
      GroupName: 'cloudformation-readonly-group'

  AddUserToGroup:
    Type: 'AWS::IAM::UserToGroupAddition'
    Properties:
      GroupName: !Ref MyIAMGroup
      Users:
        - !Ref MyIAMUser

  MyManagedPolicy:
    Type: 'AWS::IAM::ManagedPolicy'
    Properties:
      ManagedPolicyName: 'cloudformation-ec2-describe-policy'
      Description: 'Allows read-only EC2 describe actions'
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Action:
              - 'ec2:Describe*'
            Resource: '*'
      Groups:
        - !Ref MyIAMGroup

  MyIAMRole:
    Type: 'AWS::IAM::Role'
    Properties:
      RoleName: 'cloudformation-ec2-readonly-role'
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: 'ec2.amazonaws.com'
            Action: 'sts:AssumeRole'
      ManagedPolicyArns:
        - !Ref MyManagedPolicy
